# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=notary_user
DB_PASSWORD=notary_password
DB_NAME=notary_db
DB_SSL=false
DB_LOGGING=true

# JWT
JWT_SECRET=your-very-secure-jwt-secret-key-minimum-32-characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-very-secure-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Fraud Detection Thresholds
FRAUD_HOURLY_THRESHOLD=20
FRAUD_DAILY_THRESHOLD=100
FRAUD_BURST_WINDOW=300
FRAUD_BURST_THRESHOLD=10

# PgAdmin (dev only)
PGADMIN_EMAIL=admin@notary.ph
PGADMIN_PASSWORD=admin
